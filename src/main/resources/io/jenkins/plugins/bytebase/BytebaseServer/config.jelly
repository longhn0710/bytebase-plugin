<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="Connection name" field="name"
      description="A Jenkins alias, such as bytebase-lab. Use this value as serverName in the Pipeline step.">
    <f:textbox/>
  </f:entry>
  <f:entry title="Bytebase base URL" field="url"
      description="The URL used to open Bytebase, such as https://bytebase.example.com. Do not append /v1 or an API method.">
    <f:textbox/>
  </f:entry>
  <f:entry title="Service account credential (Username with password)" field="credentialsId"
      description="Username: service account email. Password: Service Key. Select an existing Jenkins credential or use Add to create one.">
    <c:select/>
  </f:entry>
  <f:validateButton title="Test connection" progress="Testing..." method="testConnection" with="name,url,credentialsId"/>
</j:jelly>
