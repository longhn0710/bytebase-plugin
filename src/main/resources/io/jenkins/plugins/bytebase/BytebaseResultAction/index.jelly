<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:l="/lib/layout" xmlns:st="jelly:stapler">
  <l:layout title="Bytebase results"><l:main-panel>
    <h1>Bytebase results</h1>
    <p>SQL check results and resources created by this build. Rollout execution remains subject to Bytebase policies.</p>
    <p>Each report starts with the Bytebase command, followed by its JSON output as plain text.</p>
    <pre><st:out value="${it.report}"/></pre>
  </l:main-panel></l:layout>
</j:jelly>
